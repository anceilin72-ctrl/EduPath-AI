# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env
# Never commit the real .env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# Where MongoDB is. The app works with either a local server or a hosted Atlas
# cluster; only this line changes.
#
# LOCAL (the default, and what SETUP.md walks through). Needs MongoDB Community
# Server installed and running as a Windows service. No username or password.
# Use 127.0.0.1 and not localhost: on Windows, "localhost" resolves to the IPv6
# address ::1 first, and MongoDB listens on IPv4 by default.
MONGODB_URI=mongodb://127.0.0.1:27017/careerRoadmap

# ATLAS (alternative). Get the string from Atlas: Database > Connect > Drivers,
# replace <db_password> with the real password, and add the database name
# careerRoadmap before the "?". Note that many college and hostel networks block
# outbound port 27017, which makes Atlas unreachable no matter what you put here.
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@yourcluster.xxxxx.mongodb.net/careerRoadmap?retryWrites=true&w=majority

# Secret used to sign JWTs. Use any long random string for local development.
JWT_SECRET=change_this_to_a_long_random_string_before_you_deploy
JWT_EXPIRES_IN=7d

# Port the API listens on. The Vite dev server proxies /api to this port.
PORT=5000

# Where the React dev server runs (used for the CORS allow-list).
CLIENT_ORIGIN=http://localhost:3000

# OPTIONAL. Leave completely blank to run without AI.
# When blank, the app still generates full roadmaps — the deterministic engine
# does all the planning work and a rule-based writer produces the narrative.
# The AI only rewords the explanation; it never invents the plan itself.
GEMINI_API_KEY=
