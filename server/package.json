    "test:engine": "node tests/engine.test.mjs",
    "test:progress": "node tests/progress.test.mjs",
    "test:resume": "node tests/resume.test.mjs",
    "test:narrative": "node tests/narrative.test.mjs",
    "test:evidence": "node tests/evidence.test.mjs",
    "test:gaps": "node tests/gaps.test.mjs",
    "test:assessment": "node tests/assessment.test.mjs",
    "test:adaptive": "node tests/adaptive.test.mjs",
    "test:agent": "node tests/agent.test.mjs",
    "test:phase6": "node tests/phase6.test.mjs",
    "test:phase9": "node tests/phase9.test.mjs",
    "test:phase10": "node tests/phase10.test.mjs",
    "test:phase11": "node tests/phase11.test.mjs",
    "test:e2e": "node tests/e2e_full_loop.test.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
